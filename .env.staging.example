NODE_ENV=production
API_PORT=3100
WEB_ORIGIN=https://sim-ets-staging.example.id
DATABASE_URL=postgresql://sim_ets:replace-with-secret@postgres:5432/sim_ets
PERSISTENCE_MODE=postgres
AUTH_MODE=api-key
# Minimum 16-character keys. Replace every example before deployment.
API_KEYS_JSON=[{"apiKey":"replace-admin-key-min-16-chars","actorId":"STAGING-ADMIN","roles":["ADMIN","AUDITOR","MARKET_OPERATOR","SETTLEMENT_OPERATOR","UAT_OPERATOR"]},{"apiKey":"replace-trader-key-min-16-chars","actorId":"TRADER-PARTICIPANT","roles":["TRADER"],"participantId":"replace-participant-id"}]
RATE_LIMIT_PER_MINUTE=120
VITE_API_BASE_URL=https://sim-ets-staging-api.example.id/api/v1
