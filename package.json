{
  "name": "sim-ets-pti",
  "version": "0.1.0",
  "private": true,
  "description": "Simulator Regular Market PTBAE-IND",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @sim-ets/api --filter @sim-ets/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "data:generate:synthetic": "node data/synthetic/generate-dataset.mjs",
    "data:validate:synthetic": "node data/synthetic/validate-dataset.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File database/migrate.ps1",
    "db:seed:synthetic": "powershell -NoProfile -ExecutionPolicy Bypass -File database/seed-synthetic.ps1",
    "db:bootstrap": "node apps/api/scripts/database-bootstrap.mjs",
    "uat:synthetic": "node uat/synthetic-market-uat.mjs",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "engines": {
    "node": ">=22"
  }
}
